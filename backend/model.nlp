  "nlgManager": {
    "settings": {
      "tag": "nlg-manager"
    },
    "responses": {
      "en": {
        "cyber.phishing": [
          {
            "answer": "Phishing is a cyber attack where hackers trick users into revealing passwords, OTPs, or bank details using fake emails, websites, or messages."
          }
        ],
        "cyber.password_security": [
          {
            "answer": "Hackers steal passwords using phishing pages, malware, keyloggers, weak passwords, and leaked databases. Use strong passwords and enable two-factor authentication."
          }
        ],
        "cyber.malware": [
          {
            "answer": "Malware is harmful software designed to damage systems, steal data, or spy on users."
          }
        ],
        "cyber.ransomware": [
          {
            "answer": "Ransomware is malware that locks or encrypts files and demands payment to restore access."
          }
        ],
        "faq.network.6a33ac113a08318a8ded4acc": [
          {
            "answer": "Change default router credentials, use WPA3 or WPA2-AES, hide SSID if appropriate, disable WPS, enable guest network for IoT, and keep firmware updated."
          }
        ],
        "faq.threats.6a33ac113a08318a8ded4acd": [
          {
            "answer": "An IR plan defines roles, detection, containment, eradication, recovery, and lessons learned after a breach. Practice tabletop exercises and keep emergency contacts updated."
          }
        ],
        "faq.general.6a33b5a835a610d503b33633": [
          {
            "answer": "Symmetric encryption uses one key for both encryption and decryption. Asymmetric encryption uses two keys: a public key for encryption and a private key for decryption."
          }
        ],
        "faq.general.6a33bae8cb16e1fdad27b0ea": [
          {
            "answer": "**Asymmetric encryption** uses a pair of keys to secure data:\n* **Public Key**: Shared with anyone to **encrypt** data.\n* **Private Key**: Kept secret by the owner to **decrypt** data.\n* **Security**: Ensures confidentiality and authentication."
          }
        ]
      }
    }
  },
